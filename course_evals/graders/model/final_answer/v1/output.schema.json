{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["pass", "reason", "labels"],
  "properties": {
    "pass": {"type": "integer", "enum": [0, 1]},
    "reason": {"type": "string", "minLength": 1},
    "labels": {"type": "array", "items": {"type": "string"}}
  }
}
